# ====================================
# SMS Filing Platform Docker 部署环境变量配置
# ====================================
# 复制此文件为 .env.deploy 并根据实际情况修改配置

# ==================== 基础配置 ====================
# 项目名称
PROJECT_NAME=SMS Filing Management Platform
STACK_NAME=sms-filing-platform

# 部署环境: production, staging, development
ENVIRONMENT=production

# ==================== 域名配置 ====================
# 主域名（如果使用域名访问）
DOMAIN=39.105.3.36

# 前端访问地址
FRONTEND_HOST=http://39.105.3.36:30100

# API 访问地址（前端构建时使用）
# 留空表示使用相对路径，通过 Nginx 反向代理访问后端
VITE_API_URL=

# ==================== 后端配置 ====================
# CORS 允许的源（多个用逗号分隔）
BACKEND_CORS_ORIGINS=http://39.105.3.36:30100,http://39.105.3.36,http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# 安全密钥（请务必修改为随机字符串！）
# 可以使用以下命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=Gn5fU1vlRbe4l9NJRK1xEPrF_FD34vxTCFwZ-0WebXE

# 首个超级管理员账号
FIRST_SUPERUSER=admin@sms-filing.example.com
FIRST_SUPERUSER_PASSWORD=admin@sms-filing123

# ==================== 邮件配置 ====================
# SMTP 邮件服务器配置（可选，用于发送邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@example.com

# ==================== 数据库配置 ====================
# PostgreSQL 数据库配置
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=sms_filing
POSTGRES_USER=sms_filing
# 数据库密码（请务必修改！）
POSTGRES_PASSWORD=changethis-db-password

# ==================== 监控配置 ====================
# Sentry DSN（可选，用于错误追踪）
SENTRY_DSN=

# ==================== Docker 镜像配置 ====================
# Docker 镜像名称（如果需要推送到镜像仓库）
DOCKER_IMAGE_BACKEND=sms-filing-backend
DOCKER_IMAGE_FRONTEND=sms-filing-frontend
TAG=latest

# 后端 Dockerfile 选择 (可选)
BACKEND_DOCKERFILE=Dockerfile

# pip 镜像源配置
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# ==================== 注意事项 ====================
# 1. 所有标记为 "changethis" 的值都必须在生产环境中修改
# 2. SECRET_KEY 必须是一个安全的随机字符串
# 3. 数据库密码应该使用强密码
# 4. 如果部署到公网，请确保修改所有默认密码
# 5. BACKEND_CORS_ORIGINS 应该只包含信任的域名
